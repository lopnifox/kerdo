<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="400.0" prefWidth="600.0" spacing="16.0" style="-fx-background-color: #f4f6f9; -fx-font-size: 13px; -fx-accent: #2f80ed; -fx-focus-color: #2f80ed;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controllers.MainController">
   <padding>
      <Insets bottom="24.0" left="32.0" right="32.0" top="20.0" />
   </padding>
   <children>
      <Label fx:id="titleLabel" alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Kvíz" />

      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <TextField fx:id="idField" alignment="CENTER" prefHeight="32.0" prefWidth="56.0" promptText="ID" style="-fx-font-weight: bold;" />
            <TextField fx:id="questionField" prefHeight="32.0" promptText="Kérdés" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>

      <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dde1e7; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="16.0" left="20.0" right="20.0" top="14.0" />
         </padding>
         <children>
            <Label style="-fx-font-weight: bold; -fx-text-fill: #6b7280;" text="Válaszok" />
            <RadioButton fx:id="answer1Radio" mnemonicParsing="false" text="Válasz 1">
               <toggleGroup>
                  <ToggleGroup fx:id="answers" />
               </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="answer2Radio" mnemonicParsing="false" text="Válasz 2" toggleGroup="$answers" />
            <RadioButton fx:id="answer3Radio" mnemonicParsing="false" text="Válasz 3" toggleGroup="$answers" />
            <RadioButton fx:id="answer4Radio" mnemonicParsing="false" text="Válasz 4" toggleGroup="$answers" />
         </children>
      </VBox>

      <!-- Gombok -->
      <HBox alignment="CENTER" spacing="16.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onClickPreviousButton" prefHeight="34.0" prefWidth="120.0" text="◀  Előző" />
            <Button defaultButton="true" mnemonicParsing="false" onAction="#onClickSaveButton" prefHeight="34.0" prefWidth="120.0" style="-fx-base: #2f80ed; -fx-font-weight: bold;" text="Mentés" />
            <Button mnemonicParsing="false" onAction="#onClickNextButton" prefHeight="34.0" prefWidth="120.0" text="Következő  ▶" />
         </children>
      </HBox>
   </children>
</VBox>
